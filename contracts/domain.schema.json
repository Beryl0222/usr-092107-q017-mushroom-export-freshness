{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "野生菌出口鲜度链领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "LOT_RECEIVED",
        "SPECIES_CONFIRMED",
        "CERTIFICATE_ISSUED",
        "BOOKING_REVISED",
        "DELIVERY_ACCEPTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "foraged_lot",
        "processing_batch",
        "export_clearance",
        "transport_booking"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
